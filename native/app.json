{
  "expo": {
    "name": "OENOD",
    "slug": "oenod",
    "version": "4.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oenod.app",
      "buildNumber": "401",
      "associatedDomains": [
        "applinks:oenod.com",
        "webcredentials:oenod.com"
      ],
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "OENOD uses your location to confirm you are at your workplace when you clock in. If your workplace uses site attendance, it also shares your location with your managers while you are clocked in and OENOD is open on your screen. Never on breaks, after you clock out, or while the app is closed.",
        "NSCameraUsageDescription": "OENOD uses the camera to scan QR badges and for video meetings.",
        "NSFaceIDUsageDescription": "OENOD uses Face ID to unlock the app quickly.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationAlwaysAndWhenInUseUsageDescription": "OENOD uses your location to confirm you are at your workplace when you clock in. If your workplace uses site attendance, it also shares your location with your managers while you are clocked in and OENOD is open on your screen. Never on breaks, after you clock out, or while the app is closed.",
        "UIRequiresFullScreen": true,
        "NSMicrophoneUsageDescription": "OENOD uses the microphone for video meetings in OENOD Meet and for Business Phone calls.",
        "UISupportedInterfaceOrientations~ipad": [
          "UIInterfaceOrientationPortrait",
          "UIInterfaceOrientationPortraitUpsideDown",
          "UIInterfaceOrientationLandscapeLeft",
          "UIInterfaceOrientationLandscapeRight"
        ],
        "NSSupportsLiveActivities": true
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "appleTeamId": "9R7RL2AH43"
    },
    "android": {
      "package": "com.oenod.app",
      "versionCode": 401,
      "adaptiveIcon": {
        "backgroundColor": "#000C58",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "BLUETOOTH_CONNECT",
        "USE_FULL_SCREEN_INTENT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#000C58"
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "OENOD uses your location to confirm you are at your workplace when you clock in. If your workplace uses site attendance, it also shares your location with your managers while you are clocked in and OENOD is open on your screen. Never on breaks, after you clock out, or while the app is closed.",
          "locationAlwaysAndWhenInUsePermission": "OENOD uses your location to confirm you are at your workplace when you clock in. If your workplace uses site attendance, it also shares your location with your managers while you are clocked in and OENOD is open on your screen. Never on breaks, after you clock out, or while the app is closed.",
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "OENOD uses the camera to scan QR badges and for video meetings.",
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "OENOD uses Face ID to unlock the app quickly."
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#0B1B3F"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withWear",
      "./plugins/withPhoneCalls",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "SeasonXmas",
            "ios": "./assets/season/ios-xmas.png",
            "android": {
              "foregroundImage": "./assets/season/fg-xmas.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonNewyear",
            "ios": "./assets/season/ios-newyear.png",
            "android": {
              "foregroundImage": "./assets/season/fg-newyear.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonCanada",
            "ios": "./assets/season/ios-canada.png",
            "android": {
              "foregroundImage": "./assets/season/fg-canada.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonJuly4",
            "ios": "./assets/season/ios-july4.png",
            "android": {
              "foregroundImage": "./assets/season/fg-july4.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonEid",
            "ios": "./assets/season/ios-eid.png",
            "android": {
              "foregroundImage": "./assets/season/fg-eid.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonRamadan",
            "ios": "./assets/season/ios-ramadan.png",
            "android": {
              "foregroundImage": "./assets/season/fg-ramadan.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonDiwali",
            "ios": "./assets/season/ios-diwali.png",
            "android": {
              "foregroundImage": "./assets/season/fg-diwali.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonLunar",
            "ios": "./assets/season/ios-lunar.png",
            "android": {
              "foregroundImage": "./assets/season/fg-lunar.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonHalloween",
            "ios": "./assets/season/ios-halloween.png",
            "android": {
              "foregroundImage": "./assets/season/fg-halloween.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonPoppy",
            "ios": "./assets/season/ios-poppy.png",
            "android": {
              "foregroundImage": "./assets/season/fg-poppy.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonThanks",
            "ios": "./assets/season/ios-thanks.png",
            "android": {
              "foregroundImage": "./assets/season/fg-thanks.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonStpat",
            "ios": "./assets/season/ios-stpat.png",
            "android": {
              "foregroundImage": "./assets/season/fg-stpat.png",
              "backgroundColor": "#00063D"
            }
          },
          {
            "name": "SeasonValentine",
            "ios": "./assets/season/ios-valentine.png",
            "android": {
              "foregroundImage": "./assets/season/fg-valentine.png",
              "backgroundColor": "#00063D"
            }
          }
        ]
      ],
      [
        "@twilio/voice-react-native-sdk",
        {
          "apsEnvironment": "production",
          "microphoneUsageDescription": "OENOD uses the microphone for video meetings in OENOD Meet and for Business Phone calls."
        }
      ]
    ],
    "scheme": "oenod",
    "backgroundColor": "#050B24",
    "extra": {
      "apiUrl": "https://oenod.com"
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}
