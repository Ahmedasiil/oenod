# App Store signing without a Mac or test devices.
# Uses only the App Store Connect API key from the GitHub secrets. Each run makes a short-lived
# Apple Distribution certificate, an App Store profile, archives, uploads, then revokes the certificate
# (apps already uploaded or on the App Store are not affected by revoking it).
default_platform(:ios)
BUNDLE = 'com.oenod.app'

platform :ios do
  def api
    @api ||= app_store_connect_api_key(
      key_id: ENV['APPLE_KEY_ID'], issuer_id: ENV['APPLE_ISSUER_ID'],
      key_content: ENV['APPLE_KEY_P8'], duration: 1200, in_house: false)
  end

  desc 'Register the bundle ID (with Associated Domains + Push) and check the App Store Connect app record'
  lane :prepare do
    api
    bid = Spaceship::ConnectAPI::BundleId.find(BUNDLE)
    if bid
      UI.message("RESULT bundle-id: already registered")
    else
      bid = Spaceship::ConnectAPI::BundleId.create(name: 'OENOD', platform: 'IOS', identifier: BUNDLE)
      UI.success('RESULT bundle-id: registered com.oenod.app now')
    end
    have = (bid.get_capabilities rescue []).map { |c| c.capability_type }
    %w[ASSOCIATED_DOMAINS PUSH_NOTIFICATIONS].each do |cap|
      next if have.include?(cap)
      begin
        bid.create_capability(cap)
        UI.success("RESULT capability #{cap}: added")
      rescue => e
        UI.important("RESULT capability #{cap}: could not add (#{e.message})")
      end
    end
    app = Spaceship::ConnectAPI::App.find(BUNDLE)
    if app
      UI.success('RESULT app-record: found')
    else
      UI.user_error!('RESULT app-record: MISSING. Create the app in App Store Connect (Apps, +, New App, bundle ID com.oenod.app), then run again.')
    end
  end

  desc 'Sign with a temporary distribution certificate, archive and upload to App Store Connect'
  lane :release do
    api
    kc_pass = SecureRandom.hex(16)
    create_keychain(name: 'oenod-ci', password: kc_pass, default_keychain: true, unlock: true, timeout: 7200, lock_when_sleeps: false)
    kc = File.expand_path('~/Library/Keychains/oenod-ci-db')
    cert_id = nil
    begin
      get_certificates(api_key: api, development: false, keychain_path: kc, keychain_password: kc_pass, output_path: ENV['RUNNER_TEMP'])
      cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]
      get_provisioning_profile(api_key: api, app_identifier: BUNDLE, force: true, output_path: ENV['RUNNER_TEMP'],
                               cert_id: cert_id, provisioning_name: "OENOD App Store #{Time.now.utc.strftime('%Y%m%d%H%M')}")
      profile = lane_context[SharedValues::SIGH_NAME]
      ws = Dir['../../ios/*.xcworkspace'].first
      proj = Dir['../../ios/*.xcodeproj'].reject { |p| p.include?('Pods') }.first
      scheme = File.basename(ws, '.xcworkspace')
      update_code_signing_settings(path: File.expand_path(proj), use_automatic_signing: false, team_id: ENV['APPLE_TEAM_ID'],
                                   targets: [scheme], code_sign_identity: 'Apple Distribution', profile_name: profile, bundle_identifier: BUNDLE)
      build_app(workspace: File.expand_path(ws), scheme: scheme, configuration: 'Release', export_method: 'app-store',
                clean: true, output_directory: ENV['RUNNER_TEMP'], output_name: 'OENOD.ipa', xcargs: "DEVELOPMENT_TEAM=#{ENV['APPLE_TEAM_ID']}",
                export_options: { provisioningProfiles: { BUNDLE => profile }, signingStyle: 'manual', teamID: ENV['APPLE_TEAM_ID'] })
      upload_to_testflight(api_key: api, ipa: File.join(ENV['RUNNER_TEMP'], 'OENOD.ipa'), skip_waiting_for_build_processing: true,
                           skip_submission: true)
      UI.success('RESULT upload: done. The build shows in App Store Connect in about 15 minutes.')
    ensure
      if cert_id
        begin
          Spaceship::ConnectAPI::Certificate.get(certificate_id: cert_id).delete!
          UI.message('RESULT temporary certificate: revoked')
        rescue => e
          UI.important("RESULT temporary certificate: could not revoke (#{e.message})")
        end
      end
    end
  end
end
