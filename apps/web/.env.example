# ─── Required ────────────────────────────────────────────────
# PostgreSQL connection (Supabase, Neon, RDS, your own server...)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/oenod?schema=public"
# Public address of the website, no trailing slash
APP_URL="https://oenod.com"
# Long random strings (run: openssl rand -base64 48)
AUTH_SECRET=""
ENCRYPTION_KEY=""
# Protects the scheduled-jobs endpoint /api/cron/*
CRON_SECRET=""
# The first account that signs up with this email becomes Super Admin
SUPER_ADMIN_EMAIL="you@yourcompany.com"

# ─── AI Business Manager (Anthropic) ─────────────────────────
ANTHROPIC_API_KEY=""

# ─── Payments (Stripe) ───────────────────────────────────────
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ─── Email (Resend) and SMS / WhatsApp (Twilio) ──────────────
RESEND_API_KEY=""
EMAIL_FROM="OENOD <hello@oenod.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# ─── Integrations (create OAuth apps, paste client id/secret) ─
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
META_CLIENT_ID=""
META_CLIENT_SECRET=""
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SHOPIFY_CLIENT_ID=""
SHOPIFY_CLIENT_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
TIKTOK_CLIENT_ID=""
TIKTOK_CLIENT_SECRET=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""
MAILCHIMP_CLIENT_ID=""
MAILCHIMP_CLIENT_SECRET=""
SQUARE_CLIENT_ID=""
SQUARE_CLIENT_SECRET=""
TWILIO_FROM=""

# Everything below is optional. Most keys can also be entered in
# Super admin > Plugin centre instead of here (saved there = takes priority).

# ─── AI model (defaults to the latest Claude model) ─────────
AI_MODEL=""

# ─── Mobile push (optional; pushes work without it) ─────────
EXPO_ACCESS_TOKEN=""

# ─── Security ───────────────────────────────────────────────
# Requests per minute per API key (default 120)
API_RATE_LIMIT="120"
# Behind a proxy/CDN: which header carries the visitor's IP, and how many proxies to trust
CLIENT_IP_HEADER=""
TRUSTED_PROXY_HOPS="1"
# Super admins must use two-step sign-in in production. Only set "true" for a first setup.
SUPER_ADMIN_ALLOW_NO_2FA=""

# ─── Legal pages ────────────────────────────────────────────
# Set to 1 once a lawyer has reviewed /legal/privacy and /legal/terms (hides the "template" banner)
NEXT_PUBLIC_LEGAL_REVIEWED=""

# ─── Maps (live map, fleet, directory) ──────────────────────
# Tile URL with {z}/{x}/{y}; defaults to OpenStreetMap, which is for light use only
NEXT_PUBLIC_MAP_TILES=""
NEXT_PUBLIC_MAP_ATTRIBUTION=""

# ─── Download links shown on the website ────────────────────
NEXT_PUBLIC_IOS_URL=""
NEXT_PUBLIC_ANDROID_URL=""
NEXT_PUBLIC_DESKTOP_WIN_URL=""
NEXT_PUBLIC_DESKTOP_MAC_URL=""
NEXT_PUBLIC_DESKTOP_LINUX_URL=""

# ─── oenodpay (all can be set in Super admin > Plugin centre instead) ─
# Wallet currency and launch countries (accounts can be opened by people living here)
PAY_BASE_CURRENCY="CAD"
PAY_HOME_COUNTRIES="CA,US"
PAY_SOURCE_COUNTRY="CA"
PAY_TIMEZONE="America/Toronto"
# Bank payouts and live FX
AIRWALLEX_CLIENT_ID=""
AIRWALLEX_API_KEY=""
AIRWALLEX_ENV="demo"            # live when you go live
AIRWALLEX_WEBHOOK_SECRET=""
# Mobile wallets, InstaPay, cash pickup
THUNES_API_KEY=""
THUNES_API_SECRET=""
THUNES_ENV="pre"                # live when you go live
THUNES_CALLBACK_SECRET=""       # any long random text
# Sanctions and PEP screening
OPENSANCTIONS_API_KEY=""
# Live markets (crypto works without a key)
TWELVEDATA_API_KEY=""
COINGECKO_API_KEY=""
# Travel eSIM
AIRALO_CLIENT_ID=""
AIRALO_CLIENT_SECRET=""
AIRALO_ENV="sandbox"            # live when you go live
# AI call center (uses the Twilio keys above)
SUPPORT_PHONE=""
SUPPORT_AGENT_PHONE=""
# Optional tuning (cents in the wallet currency)
PAY_FX_MARKUP_BPS="50"
PAY_FEE_FIXED_CENTS="199"
PAY_FEE_PCT="0.5"
PAY_REVIEW_OVER_CENTS="300000"
PAY_REPORT_OVER_CENTS="1000000"
PAY_STEP_UP_OVER_CENTS="100000"
PAY_NEW_DEVICE_CAP_CENTS="25000"
PAY_ESIM_MARKUP_PCT="20"
PAY_BLOCKED_COUNTRIES="KP,IR,MM"
