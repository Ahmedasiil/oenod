  requireAck Boolean      @default(false)
  acks       String[] // user ids
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Document {
  id         String       @id @default(cuid())
  orgId      String
  name       String
  kind       String       @default("OTHER") // CONTRACT, POLICY, RECEIPT, CERTIFICATE, PERMIT, INSURANCE, OTHER
  entityType String?
  entityId   String?
  mime       String?
  size       Int?
  data       Bytes?
  url        String?
  version    Int          @default(1)
  expiresAt  DateTime?
  signedAt   DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model ComplianceItem {
  id         String       @id @default(cuid())
  orgId      String
  title      String
  category   String       @default("General")
  dueDate    DateTime
  owner      String?
  status     String       @default("OPEN") // OPEN, DONE, OVERDUE
  recurrence String?
  evidence   String?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Academy (learning marketplace + company training) ─────────────────────────

model Course {
  id             String               @id @default(cuid())
  orgId          String? // null = published by OENOD
  slug           String               @unique
  title          String
  summary        String
  description    String?
  category       String               @default("Business")
  level          String               @default("Beginner")
  instructorName String
  priceCents     Int                  @default(0)
  compareAtCents Int? // original price when on sale
  currency       String               @default("CAD")
  coverColor     String               @default("#2342E0")
  outcomes       String[] // "What you'll learn"
  audience       String? // who it's for
  tags           String[]
  featured       Boolean              @default(false)
  language       String               @default("en")
  updatedAt      DateTime             @default(now()) @updatedAt
  durationMin    Int                  @default(60)
  certificate    Boolean              @default(true)
  isPublic       Boolean              @default(true) // false = internal company training
  published      Boolean              @default(true)
  rating         Float                @default(4.8)
  enrollCount    Int                  @default(0)
  createdAt      DateTime             @default(now())
  org            Organization?        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lessons        Lesson[]
  enrollments    Enrollment[]
  assignments    TrainingAssignment[]
}

model Lesson {
  id          String  @id @default(cuid())
  courseId    String
  title       String
  order       Int
  content     String
  videoUrl    String?
  durationMin Int     @default(10)
  quiz        Json?
  isPreview   Boolean @default(false) // free to read before buying
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id               String    @id @default(cuid())
  courseId         String
  userId           String
  completedLessons String[]
  progress         Int       @default(0)
  completedAt      DateTime?
  certificateCode  String?   @unique
  source           String    @default("FREE") // FREE, PURCHASE, PASS, COMPANY, ASSIGNED
  paidCents        Int       @default(0)
  lastLessonId     String?
  sponsorOrgId     String? // the company that provided this training, shown on the certificate
  createdAt        DateTime  @default(now())
  course           Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
}

/// A certificate a company issues itself: outside training, safety tickets, awards, recognition.
model IssuedCertificate {
  id             String       @id @default(cuid())
  orgId          String
  code           String       @unique
  kind           String       @default("COMPLETION") // COMPLETION, ACHIEVEMENT, APPRECIATION, SAFETY, PARTICIPATION, EXCELLENCE
  title          String
  description    String?
  recipientName  String
  recipientEmail String?
  employeeId     String?
  hours          Float?
  signerName     String?
  signerTitle    String?
  issuedAt       DateTime     @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokeReason   String?
  createdById    String?
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, issuedAt])
  @@index([employeeId])
}

model TrainingAssignment {
  id         String       @id @default(cuid())
  orgId      String
  courseId   String
  employeeId String
  dueDate    DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ───────────────────────── AI Business Manager ─────────────────────────

model AiConversation {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  title     String       @default("New conversation")
  messages  Json         @default("[]") // Anthropic MessageParam[] (kept append-only)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiAction {
  id             String       @id @default(cuid())
  orgId          String
  worker         String // COORDINATOR, HR, SCHEDULING, PAYROLL, FINANCE, SALES, MARKETING, INVENTORY, SERVICE, OPERATIONS, COMPLIANCE, REPORTING
  title          String
  reason         String?
  tool           String?
  input          Json?
  result         Json?
  status         String       @default("NEEDS_APPROVAL") // COMPLETED, IN_PROGRESS, NEEDS_APPROVAL, BLOCKED, UPCOMING, REJECTED, FAILED, SIMULATED
  autonomy       String       @default("APPROVE") // ASSIST, APPROVE, AUTO
  sources        Json?
  requestedBy    String?
  decidedBy      String?
  decidedAt      DateTime?
  executedAt     DateTime?
  scheduledFor   DateTime?
  idempotencyKey String?      @unique
  error          String?
  createdAt      DateTime     @default(now())
  org            Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
}

model AutomationRule {
  id         String       @id @default(cuid())
  orgId      String
  name       String
  trigger    String // INVOICE_OVERDUE, STOCK_LOW, SHIFT_MISSED, OFFER_ACCEPTED, QUOTE_ACCEPTED, CONTRACT_EXPIRING, EMPLOYEE_LEAVING, NEW_REVIEW, NEW_LEAD
  conditions Json?
  action     String // SEND_REMINDER, CREATE_PO, NOTIFY_MANAGER, CREATE_TASK, ONBOARD, REPLY_REVIEW, FOLLOW_UP
  autonomy   String       @default("APPROVE")
  spendLimit Decimal?     @db.Decimal(12, 2)
  enabled    Boolean      @default(true)
  runCount   Int          @default(0)
  lastRunAt  DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Integrations, public API, webhooks ─────────────────────────

model Integration {
  id           String       @id @default(cuid())
  orgId        String
  provider     String // google_business, google_calendar, gmail, meta, instagram, tiktok, linkedin, stripe, square, shopify, woocommerce, quickbooks, xero, slack, zoom, mailchimp, ...
  status       String       @default("CONNECTED") // CONNECTED, ERROR, DISCONNECTED
  accountName  String?
  externalId   String?
  accessToken  String? // encrypted at rest (AES-256-GCM)
  refreshToken String? // encrypted at rest
  expiresAt    DateTime?
  scopes       String[]
  config       Json?
  lastSyncAt   DateTime?
  lastError    String?
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, provider])
}

model Webhook {
  id         String            @id @default(cuid())
  orgId      String
  url        String
  events     String[]
  secret     String
  active     Boolean           @default(true)
  lastStatus Int?
  createdAt  DateTime          @default(now())
  org        Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]
}

model WebhookDelivery {
  id            String    @id @default(cuid())
  webhookId     String
  event         String
  payload       Json
  status        String    @default("PENDING") // PENDING, DELIVERED, FAILED
  responseCode  Int?
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())
  webhook       Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

// ───────────────────────── Monitoring and alerts ─────────────────────────

model Monitor {
  id            String         @id @default(cuid())
  orgId         String
  name          String
  kind          String // LOW_STOCK, OVERDUE_INVOICES, UNCOVERED_SHIFTS, LATE_WORK_ORDERS, EXPIRING_CERTS, UPTIME, SALES_DROP, REVIEW_RATING, INTEGRATION_HEALTH, OPEN_TICKETS, CASH_BALANCE, OVERTIME
  config        Json?
  threshold     Float?
  severity      String         @default("WARN") // INFO, WARN, CRIT
  channels      String[]       @default(["IN_APP"]) // IN_APP, EMAIL, SMS, WEBHOOK, PUSH
  recipients    String[]
  intervalMin   Int            @default(15)
  enabled       Boolean        @default(true)
  lastCheckedAt DateTime?
  lastStatus    String         @default("OK") // OK, WARN, CRIT, ERROR
  lastValue     Float?
  createdAt     DateTime       @default(now())
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  checks        MonitorCheck[]
  alerts        Alert[]
}

model MonitorCheck {
  id        String   @id @default(cuid())
  monitorId String
  status    String
  value     Float?
  message   String?
  createdAt DateTime @default(now())
  monitor   Monitor  @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, createdAt])
}

model Alert {
  id         String       @id @default(cuid())
  orgId      String
  monitorId  String?
  title      String
  message    String
  severity   String       @default("WARN")
  status     String       @default("OPEN") // OPEN, ACKNOWLEDGED, RESOLVED
  link       String?
  ackBy      String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  monitor    Monitor?     @relation(fields: [monitorId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
}

// ───────────────────────── Super admin and growth marketing ─────────────────────────

// People who gave OENOD permission to contact them (website, Jobs, Academy, events).
model Lead {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  phone           String?
  company         String?
  locale          String    @default("en")
  source          String    @default("website")
  utm             Json?
  tags            String[]
  emailConsent    Boolean   @default(false)
  smsConsent      Boolean   @default(false)
  consentAt       DateTime?
  consentText     String?
  consentIp       String?
  unsubscribedAt  DateTime?
  convertedUserId String?
  createdAt       DateTime  @default(now())
}

model GrowthCampaign {
  id          String    @id @default(cuid())
  name        String
  channel     String    @default("EMAIL") // EMAIL, SMS, IN_APP
  audience    String // ALL_CONSENTED, LEADS, TRIALS, TRIAL_ENDING, INACTIVE_14D, CANCELED, JOB_SEEKERS, LEARNERS, CUSTOMERS
  subject     String?
  preheader   String?
  content     String
  ctaLabel    String?
  ctaUrl      String?
  status      String    @default("DRAFT") // DRAFT, SCHEDULED, SENDING, SENT
  scheduledAt DateTime?
  sentAt      DateTime?
  sent        Int       @default(0)
  skipped     Int       @default(0)
  opened      Int       @default(0)
  clicked     Int       @default(0)
  conversions Int       @default(0)
  createdBy   String?
  createdAt   DateTime  @default(now())
}

model GrowthAutomation {
  id         String   @id @default(cuid())
  key        String   @unique
  name       String
  trigger    String // SIGNUP, TRIAL_DAY_3, TRIAL_ENDING, INACTIVE_7D, INACTIVE_30D, PAYMENT_FAILED, CANCELED, LEAD_NURTURE
  delayHours Int      @default(0)
  channel    String   @default("EMAIL")
  subject    String
  content    String
  ctaLabel   String?
  ctaUrl     String?
  enabled    Boolean  @default(true)
  sentCount  Int      @default(0)
  createdAt  DateTime @default(now())
}

model MessageLog {
  id             String   @id @default(cuid())
  scope          String   @default("PLATFORM") // PLATFORM, ORG
  orgId          String?
  channel        String
  to             String
  subject        String?
  status         String   @default("QUEUED") // QUEUED, SENT, FAILED, SKIPPED_NO_CONSENT
  providerId     String?
  campaignId     String?
  automationKey  String?
  idempotencyKey String?  @unique
  error          String?
  createdAt      DateTime @default(now())

  @@index([campaignId])
}

model FeatureFlag {
  key            String   @id
  description    String?
  enabled        Boolean  @default(false)
  rolloutPercent Int      @default(0)
  orgIds         String[]
  updatedAt      DateTime @updatedAt
}

model PlatformBanner {
  id        String   @id @default(cuid())
  message   String
  level     String   @default("info")
  link      String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model StatusIncident {
  id         String    @id @default(cuid())
  title      String
  status     String    @default("INVESTIGATING") // INVESTIGATING, IDENTIFIED, MONITORING, RESOLVED
  components String[]
  message    String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
}

// ───────────────────────── Fleet GPS tracking ─────────────────────────
// Positions come from the OENOD Driver mobile app or any GPS tracker that speaks
// the OsmAnd/Traccar HTTP protocol (POST /api/fleet/ingest).

model Vehicle {
  id            String            @id @default(cuid())
  orgId         String
  name          String
  plate         String?
  make          String?
  model         String?
  year          Int?
  vin           String?
  kind          String            @default("TRUCK") // TRUCK, VAN, CAR, BUS, TRAILER, EQUIPMENT
  driverId      String? // Employee id
  deviceId      String            @unique // tracker identifier / driver-app device id
  deviceToken   String            @unique @default(cuid())
  speedLimitKmh Int               @default(100)
  idleAlertMin  Int               @default(15)
  stopAlertMin  Int               @default(30)
  odometerKm    Float             @default(0)
  fuelType      String?
  status        String            @default("OFFLINE") // MOVING, IDLE, STOPPED, OFFLINE
  lastLat       Float?
  lastLng       Float?
  lastSpeedKmh  Float?
  lastHeading   Float?
  lastSeenAt    DateTime?
  stoppedSince  DateTime?
  nextServiceKm Float?
  createdAt     DateTime          @default(now())
  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  positions     VehiclePosition[]
  trips         Trip[]
  events        FleetEvent[]
}

model VehiclePosition {
  id        String   @id @default(cuid())
  vehicleId String
  lat       Float
  lng       Float
  speedKmh  Float    @default(0)
  heading   Float?
  altitude  Float?
  accuracy  Float?
  ignition  Boolean?
  at        DateTime @default(now())
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, at])
}

model Trip {
  id             String    @id @default(cuid())
  vehicleId      String
  driverId       String?
  startAt        DateTime
  endAt          DateTime?
  startLat       Float
  startLng       Float
  endLat         Float?
  endLng         Float?
  distanceKm     Float     @default(0)
  maxSpeedKmh    Float     @default(0)
  avgSpeedKmh    Float     @default(0)
  speedingEvents Int       @default(0)
  vehicle        Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, startAt])
}

model Geofence {
  id           String       @id @default(cuid())
  orgId        String
  name         String
  lat          Float
  lng          Float
  radiusM      Int          @default(300)
  alertOnEnter Boolean      @default(true)
  alertOnExit  Boolean      @default(true)
  createdAt    DateTime     @default(now())
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model FleetEvent {
  id        String       @id @default(cuid())
  orgId     String
  vehicleId String
  kind      String // SPEEDING, LONG_STOP, IDLE, GEOFENCE_ENTER, GEOFENCE_EXIT, OFFLINE, HARSH_BRAKE, SERVICE_DUE
  message   String
  lat       Float?
  lng       Float?
  value     Float?
  at        DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  vehicle   Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([orgId, at])
}

// ---------------------------------------------------------------------------
// Connect anything: custom connectors (any REST API, OpenAPI import, inbound
// webhooks) and the plugin marketplace.
// ---------------------------------------------------------------------------

model CustomConnector {
  id              String       @id @default(cuid())
  orgId           String
  name            String
  description     String?
  color           String       @default("#2342E0")
  baseUrl         String
  authType        String       @default("none") // none, bearer, header, query, basic, oauth2
  authConfig      Json? // secret values encrypted at rest
  // OAuth 2 (authorization code) with the customer's own app credentials
  authorizeUrl    String?
  tokenUrl        String?
  scopes          String[]
  clientId        String?
  clientSecret    String? // encrypted
  accessToken     String? // encrypted
  refreshToken    String? // encrypted
  expiresAt       DateTime?
  defaultHeaders  Json?
  actions         Json // [{ key, name, method, path, description, body }]
  // Inbound: any app can POST JSON to /api/hooks/{id}?token=... and OENOD creates records
  inboundToken    String       @unique
  inboundResource String? // contacts, tickets, orders, leads, tasks, bookings...
  inboundMapping  Json? // { oenodField: "path.in.payload" }
  status          String       @default("ACTIVE") // ACTIVE, ERROR, PAUSED
  lastError       String?
  lastUsedAt      DateTime?
  callCount       Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Plugin {
  id             String          @id @default(cuid())
  slug           String          @unique
  name           String
  tagline        String
  description    String
  category       String          @default("Productivity")
  developer      String
  website        String?
  supportEmail   String?
  color          String          @default("#000F55")
  iconUrl        String?
  // Manifest: { scopes: [modules], events: [webhook events], webhookUrl, installUrl, embed: { url, placement }, settings: [{ name, label, secret }] }
  manifest       Json
  priceCents     Int             @default(0)
  status         String          @default("REVIEW") // DRAFT, REVIEW, PUBLISHED, REJECTED
  verified       Boolean         @default(false)
  featured       Boolean         @default(false)
  installs       Int             @default(0)
  rating         Float           @default(0)
  publisherOrgId String?
  reviewNote     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  publisher      Organization?   @relation(fields: [publisherOrgId], references: [id], onDelete: SetNull)
  installations  PluginInstall[]
}

model PluginInstall {
  id          String       @id @default(cuid())
  orgId       String
  pluginId    String
  apiKeyId    String?
  webhookId   String?
  settings    Json?
  status      String       @default("ACTIVE") // ACTIVE, DISABLED
  installedBy String?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plugin      Plugin       @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([orgId, pluginId])
}

// Super admin "under construction" switches. One row per surface:
// all, web (website + web app), marketing (public site only), app (customer web app), mobile, desktop, api.
model PlatformControl {
  surface       String    @id
  mode          String    @default("LIVE") // LIVE, MAINTENANCE (paused, shows the message), READ_ONLY (viewing works, changes blocked)
  title         String    @default("We'll be right back")
  message       String    @default("OENOD is getting an upgrade. Everything will be back shortly.")
  messages      Json? // translations: { fr: "...", ar: "..." }
  startsAt      DateTime?
  endsAt        DateTime? // shown as the expected return time; auto-returns to LIVE after this
  allowAdmins   Boolean   @default(true) // super admins can still use it to test
  allowOrgIds   String[] // pilot customers that bypass maintenance
  minVersion    String? // mobile/desktop: force an update below this version
  latestVersion String?
  updateUrl     String?
  pausedModules String[] // pause single modules (e.g. payroll) everywhere
  updatedBy     String?
  updatedAt     DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Verified companies (blue badge), business directory and self-serve ads.
// ---------------------------------------------------------------------------

model VerificationRequest {
  id               String       @id @default(cuid())
  orgId            String
  legalName        String
  businessNumber   String
  registry         String? // where it's registered: "Canada - CRA", "Ontario Business Registry", "Delaware"...
  country          String
  address          Json
  website          String?
  phone            String
  contactName      String
  contactTitle     String?
  domainEmail      String? // someone@their-domain, confirmed by code
  emailCode        String? // sha256 of the code
  emailVerifiedAt  DateTime?
  documentIds      String[] // Document ids (incorporation, licence, utility bill, ID)
  aiScore          Int? // 0-100
  aiRecommendation String? // APPROVE, REVIEW, REJECT
  aiReport         Json? // { checks: [{ name, passed, note }], summary, risks }
  status           String       @default("SUBMITTED") // SUBMITTED, AI_CHECKED, VERIFIED, REJECTED, NEEDS_INFO
  reviewedBy       String?
  reviewNote       String?
  submittedAt      DateTime     @default(now())
  decidedAt        DateTime?
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([status])
}

model CompanyFollow {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}

model AdCampaign {
  id               String       @id @default(cuid())
  orgId            String
  name             String
  objective        String       @default("PROFILE_VISITS") // PROFILE_VISITS, WEBSITE, JOBS, BOOKINGS, LEADS, CALLS, APP
  status           String       @default("DRAFT") // DRAFT, REVIEW, ACTIVE, PAUSED, REJECTED, ENDED, OUT_OF_FUNDS
  headline         String
  body             String
  imageUrl         String?
  imageData        Bytes?
  imageMime        String?
  ctaLabel         String       @default("Learn more")
  destinationUrl   String? // defaults to the company profile
  placements       String[] // web_feed, web_sidebar, directory, jobs, academy, app_home, employee_home, mobile_feed
  // { countries:[], regions:[], cities:[], industries:[], audiences:[owners, employees, job_seekers, learners, customers], locales:[], lat, lng, radiusKm, ageMin? }
  targeting        Json?
  pricing          String       @default("CPC") // CPC, CPM
  bidCents         Int          @default(75) // per click or per 1,000 views
  dailyBudgetCents Int          @default(1000)
  totalBudgetCents Int?
  spentCents       Int          @default(0)
  impressions      Int          @default(0)
  clicks           Int          @default(0)
  leads            Int          @default(0)
  startAt          DateTime?
  endAt            DateTime?
  reviewNote       String?
  aiReview         Json? // policy pre-check
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stats            AdStat[]
  adLeads          AdLead[]

  @@index([status])
}

model AdStat {
  id          String     @id @default(cuid())
  campaignId  String
  date        DateTime   @db.Date
  placement   String
  impressions Int        @default(0)
  clicks      Int        @default(0)
  leads       Int        @default(0)
  spentCents  Int        @default(0)
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date, placement])
}

// One row per viewer per ad per day, so repeat views/clicks aren't billed twice.
model AdSeen {
  id         String   @id @default(cuid())
  campaignId String
  viewer     String // sha256(user id or ip+ua)
  day        String // YYYY-MM-DD
  clicked    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([campaignId, viewer, day])
}

model AdLead {
  id         String     @id @default(cuid())
  campaignId String
  name       String
  email      String
  phone      String?
  message    String?
  consent    Boolean    @default(false)
  createdAt  DateTime   @default(now())
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model AdLedger {
  id          String       @id @default(cuid())
  orgId       String
  kind        String // TOPUP, SPEND, REFUND, CREDIT
  amountCents Int // positive adds, negative spends
  reference   String?      @unique // stripe session, or campaign:day
  note        String?
  createdAt   DateTime     @default(now())
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// Academy sales: single course, Academy Pass (all courses) or company seats.
model CoursePurchase {
  id              String    @id @default(cuid())
  kind            String // COURSE, PASS_MONTH, PASS_YEAR, SEATS
  userId          String?
  orgId           String?
  courseId        String?
  seats           Int       @default(1)
  amountCents     Int
  currency        String    @default("CAD")
  stripeSessionId String?   @unique
  status          String    @default("PENDING") // PENDING, PAID, REFUNDED
  couponCode      String?
  paidAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([userId])
}

// Super admin plugin centre: platform-wide keys (payments, email, SMS, AI, OAuth apps...).
// Stored encrypted; they override hosting environment variables of the same name.
model PlatformSetting {
  key       String   @id // e.g. STRIPE_SECRET_KEY
  value     String // encrypted
  plugin    String // stripe, resend, twilio, anthropic, google, microsoft...
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Super admin AI: everything it wants to do waits here for a person's approval.
model AdminAction {
  id         String    @id @default(cuid())
  kind       String // approve_verification, approve_ad, send_growth_campaign, set_maintenance, ...
  title      String
  summary    String
  payload    Json
  status     String    @default("PROPOSED") // PROPOSED, APPROVED, REJECTED, DONE, FAILED
  proposedBy String    @default("AI")
  decidedBy  String?
  result     Json?
  error      String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([status, createdAt])
}

model AdminConversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New chat")
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Company-bought seats for paid Academy courses, used when assigning training.
model CourseSeat {
  id        String   @id @default(cuid())
  orgId     String
  courseId  String
  seats     Int
  used      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([orgId, courseId])
}

// ───────────────────────── oenodpay: personal money, inside OENOD ─────────────────────────
// Records belong to a person (userId), not a company. They are never deleted with the user:
// money records and identity checks must be kept for anti-money-laundering rules (5+ years).

// One per person: identity check, risk level and the transaction PIN.
model PayProfile {
  id                 String    @id @default(cuid())
  userId             String    @unique
  // 0 = not verified (can't move money), 1 = ID verified, 2 = ID + address / enhanced checks
  tier               Int       @default(0)
  kycStatus          String    @default("NONE") // NONE, PENDING, VERIFIED, REVIEW, REJECTED
  kycProvider        String?
  kycSessionId       String?   @unique
  kycReport          Json? // provider result: document type, country, checks (no images stored here)
  legalName          String?
  dob                DateTime?
  country            String?
  nationality        String?
  idNumberLast4      String?
  riskLevel          String    @default("LOW") // LOW, MEDIUM, HIGH
  sanctionsHit       Boolean   @default(false)
  pepHit             Boolean   @default(false)
  screenedAt         DateTime?
  frozenAt           DateTime?
  frozenReason       String?
  pinHash            String? // bcrypt of the 6-digit transaction PIN
  pinFailed          Int       @default(0)
  pinLockedUntil     DateTime?
  stripeCustomerId   String?   @unique
  stripeCardholderId String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// A balance in one currency. balanceCents is a cache of the ledger, updated in the same transaction.
model PayWallet {
  id           String          @id @default(cuid())
  userId       String
  currency     String
  balanceCents Int             @default(0)
  heldCents    Int             @default(0) // reserved for transfers in review
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  lines        PayLedgerLine[]

  @@unique([userId, currency])
}

// Double-entry journal: every movement has lines that sum to zero per currency.
model PayJournal {
  id        String          @id @default(cuid())
  userId    String
  kind      String // TOPUP, TRANSFER, FEE, REVERSAL, ESIM, CARD, ADJUSTMENT
  reference String          @unique // idempotency: the same reference can never post twice
  memo      String?
  createdAt DateTime        @default(now())
  lines     PayLedgerLine[]

  @@index([userId, createdAt])
}

model PayLedgerLine {
  id          String     @id @default(cuid())
  journalId   String
  walletId    String?
  account     String // "wallet", "clearing:stripe", "payout:airwallex", "payout:thunes", "revenue:fees", "esim:airalo"...
  amountCents Int // + credit to the account, - debit
  currency    String
  journal     PayJournal @relation(fields: [journalId], references: [id], onDelete: Restrict)
  wallet      PayWallet? @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId])
}

model PayTopUp {
  id              String   @id @default(cuid())
  userId          String
  amountCents     Int
  currency        String
  stripeSessionId String   @unique
  status          String   @default("PENDING") // PENDING, PAID, FAILED
  createdAt       DateTime @default(now())
}

// Someone a person sends money to. Account numbers are encrypted at rest.
model PayRecipient {
  id           String        @id @default(cuid())
  userId       String
  name         String
  country      String
  currency     String
  method       String // BANK, INSTAPAY, MOBILE_WALLET, CASH_PICKUP, CARD, COMPANY_WALLET, OENOD
  network      String? // e.g. "Vodafone Cash", "InstaPay", "GCash", bank name
  detailsEnc   String // encrypted JSON: account number / IBAN / phone / IPA address
  label        String? // what the sender sees: "Vodafone Cash ···· 4321"
  providerRef  String?
  sanctionsHit Boolean       @default(false)
  screenedAt   DateTime?
  createdAt    DateTime      @default(now())
  transfers    PayTransfer[]

  @@index([userId])
}

model PayTransfer {
  id              String       @id @default(cuid())
  userId          String
  recipientId     String
  sendCents       Int
  sendCurrency    String
  receiveCents    Int
  receiveCurrency String
  rate            Decimal      @db.Decimal(20, 8)
  feeCents        Int
  provider        String // airwallex, thunes, internal
  providerRef     String?
  status          String       @default("PROCESSING") // REVIEW, PROCESSING, SENT, DELIVERED, FAILED, CANCELLED, REFUNDED
  failureReason   String?
  idempotencyKey  String       @unique
  riskFlags       String[]
  reviewedBy      String?
  reviewedAt      DateTime?
  ip              String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  recipient       PayRecipient @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([status])
}

// Cards are issued by Stripe Issuing. holderUserId is the person using it (a teen on a family card).
model PayCard {
  id           String   @id @default(cuid())
  userId       String // the account owner who pays
  familyId     String?
  stripeCardId String   @unique
  type         String   @default("VIRTUAL") // VIRTUAL, PHYSICAL
  last4        String
  brand        String
  expMonth     Int
  expYear      Int
  status       String   @default("ACTIVE") // ACTIVE, INACTIVE, CANCELED
  createdAt    DateTime @default(now())

  @@index([userId])
}

// A teen (or other family member) on a parent's account, with the parent's spending rules.
model PayFamilyMember {
  id                    String    @id @default(cuid())
  parentUserId          String
  childUserId           String?
  name                  String
  birthYear             Int
  inviteEmail           String?
  status                String    @default("ACTIVE") // INVITED, ACTIVE, PAUSED
  weeklyLimitCents      Int       @default(5000)
  perPurchaseLimitCents Int?
  approvalOverCents     Int?
  blockedCategories     String[] // Stripe merchant categories, e.g. gambling, liquor_stores
  allowedMerchants      String[]
  nightLock             Boolean   @default(false) // no card payments from 22:00 to 06:00
  onlineAllowed         Boolean   @default(true)
  countries             String[] // empty = anywhere
  allowanceCents        Int       @default(0)
  allowanceWeekday      Int       @default(0) // 0 = Sunday
  lastAllowanceAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([parentUserId])
}

// Card payments a parent must approve, and every teen card decision (approved, declined and why).
model PayCardEvent {
  id           String   @id @default(cuid())
  userId       String
  familyId     String?
  cardId       String?
  stripeAuthId String?  @unique
  merchant     String
  category     String?
  city         String?
  country      String?
  amountCents  Int
  currency     String
  decision     String // APPROVED, DECLINED
  reason       String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model PayWatch {
  id         String    @id @default(cuid())
  userId     String
  symbol     String
  kind       String // STOCK, CRYPTO, METAL, FX
  alertAbove Float?
  alertBelow Float?
  alertedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, symbol])
}

model PayCoachThread {
  id        String   @id @default(cuid())
  userId    String   @unique
  messages  Json
  updatedAt DateTime @updatedAt
}

model PayEsimOrder {
  id              String   @id @default(cuid())
  userId          String
  provider        String   @default("airalo")
  packageId       String
  country         String
  title           String
  dataLabel       String
  days            Int
  priceCents      Int
  currency        String
  status          String   @default("PROCESSING") // PROCESSING, READY, FAILED, REFUNDED
  providerOrderId String?
  iccid           String?
  qrcodeUrl       String?
  lpa             String? // activation code for manual install
  journalRef      String?
  createdAt       DateTime @default(now())

  @@index([userId])
}

// Anti-money-laundering alerts for the compliance team.
model PayRiskEvent {
  id         String    @id @default(cuid())
  userId     String
  kind       String // SANCTIONS_MATCH, PEP_MATCH, LARGE_TRANSFER, VELOCITY, STRUCTURING, NEW_RECIPIENT_BURST, HIGH_RISK_COUNTRY, KYC_FAILED, PIN_LOCKED
  severity   String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  entity     String?
  entityId   String?
  details    Json?
  status     String    @default("OPEN") // OPEN, CLEARED, ESCALATED, REPORTED
  reviewedBy String?
  note       String?
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

// ───────────────────────── Customer support desk and AI call center (super admin) ─────────────────────────

model SupportCase {
  id         String           @id @default(cuid())
  userId     String?
  name       String?
  email      String?
  phone      String?
  channel    String           @default("CHAT") // CHAT, VOICE, EMAIL, APP
  subject    String
  status     String           @default("AI_HANDLING") // AI_HANDLING, WAITING_AGENT, WAITING_CUSTOMER, RESOLVED
  priority   String           @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  category   String? // TRANSFER, CARD, KYC, ACCOUNT, ESIM, FRAUD, OTHER
  assigneeId String?
  aiSummary  String?
  sentiment  String? // POSITIVE, NEUTRAL, NEGATIVE
  callSid    String?          @unique
  csat       Int?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  resolvedAt DateTime?
  messages   SupportMessage[]

  @@index([status, updatedAt])
  @@index([userId])
}

model SupportMessage {
  id        String      @id @default(cuid())
  caseId    String
  from      String // CUSTOMER, AI, AGENT, SYSTEM
  authorId  String?
  body      String
  internal  Boolean     @default(false) // agent-only note
  createdAt DateTime    @default(now())
  case      SupportCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
}
